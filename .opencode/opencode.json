{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "supabase": {
      "type": "local",
      "command": ["node", "mcp-supabase/dist/index.js"],
      "enabled": true,
      "env": {
        "SUPABASE_URL": "{env:SUPABASE_URL}",
        "SUPABASE_KEY": "{env:SUPABASE_KEY}"
      }
    }
  }
}
